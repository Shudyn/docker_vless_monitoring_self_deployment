# Add Docker's official GPG key:
sudo apt update
sudo apt install ca-certificates curl
sudo install -m 0755 -d /etc/apt/keyrings
sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
sudo chmod a+r /etc/apt/keyrings/docker.asc

# Add the repository to Apt sources:
sudo tee /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/debian
Suites: $(. /etc/os-release && echo "$VERSION_CODENAME")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

sudo apt update

#docker install
sudo apt install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

#pull images
sudo docker pull nginx
sudo docker pull ghcr.io/xtls/xray-core
sudo docker pull ejabberd/ecs
sudo docker pull grafana/grafana
sudo docker pull postgres


#run containers (configs should be in ~/dockconfigs, ssl certificates in /dockconfigs/certs/)
sudo docker run -it --rm -d --name postgre -e POSTGRES_PASSWORD=<PASSWORD> -v ~/dockconfigs/postgres-data:/var/lib/postgresql  postgres
sudo docker run -it --rm  -d --name grafana -v ~/dockconfigs/grafana:/var/lib/grafana grafana/grafana
sudo docker run -it --rm -d -p 81:443 --name xray -v ~/dockconfigs/config.json:/usr/local/etc/xray/config.json ghcr.io/xtls/xray-core
sudo docker run -it --rm -d -p 3000:3000 -v ~/dockconfigs/nginx.conf:/etc/nginx/conf.d/nginx.conf -v ~/dockconfigs/certs:/etc/nginx/certs --name nginx nginx

#set cron job for monitoring pulses
echo "*/10 * * * * ~/dockconfigs/ping_into_file.sh" >> /etc/crontab
